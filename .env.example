# .env.example — Root environment variable reference
# Copy values to apps/api/.env (never commit the real .env files).
# Each app reads from its own .env; this file is documentation only.

# ─── apps/api ──────────────────────────────────
APP_ENV=development
SECRET_KEY=CHANGE_ME_to_a_long_random_string
DATABASE_URL=postgresql+asyncpg://docite:docite@localhost:5432/docite
ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── apps/web ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ─── ai / docite_ai ────────────────────────────
# No secrets here; AI config lives in ai/src/docite_ai/config.py
# Provider API keys go in apps/api/.env:
OPENAI_API_KEY=sk-...
